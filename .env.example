# Bootstrap administrator credential. Use a unique random value >= 32 chars.
DAEP_ADMIN_TOKEN=replace-with-a-long-random-secret-at-least-32-chars
# Separate least-privilege credential for daep_worker; never reuse the admin token.
DAEP_WORKER_TOKEN=replace-with-another-independent-random-secret-at-least-32-chars
CORS_ORIGINS=http://localhost:3000

# Optional PostgreSQL backend. If unset, SQLite is used.
# DATABASE_URL=postgresql://daep_runtime:change-me@postgres:5432/daep
# Required for bootstrap, platform-admin and internal-service operations.
# This login must be a member of the PostgreSQL role daep_privileged.
# DAEP_PRIVILEGED_DATABASE_URL=postgresql://daep_privileged_login:change-me@postgres:5432/daep

# Optional OIDC/OAuth2 authorization-code integration.
# DAEP_OIDC_ISSUER=https://idp.example.com/realms/daep
# DAEP_OIDC_CLIENT_ID=daep-web
# DAEP_OIDC_CLIENT_SECRET=replace-me
# DAEP_OIDC_REDIRECT_URI=https://daep.example.com/api/v1/auth/oidc/callback
# DAEP_OIDC_AUTO_PROVISION=false
# DAEP_OIDC_DEFAULT_TENANT=tenant-default
# DAEP_OIDC_DEFAULT_ROLE=developer
# DAEP_OIDC_STATE_SECRET=replace-with-a-long-random-secret

# Optional provider-neutral Git webhook secret.
# DAEP_GIT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Worker transport gateway.
# DAEP_BROKER_WEBHOOK_URL=http://broker-gateway:8080/daep/events
# DAEP_WORKER_ID=worker-1

# RC8 PostgreSQL compose profile
# DAEP_POSTGRES_PASSWORD=replace-with-a-database-password

# Git provider-specific webhook secrets (preferred over DAEP_GIT_WEBHOOK_SECRET)\nDAEP_GITHUB_WEBHOOK_SECRET=\nDAEP_GITLAB_WEBHOOK_SECRET=\n
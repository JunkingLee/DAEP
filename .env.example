# Copy to .env for local deployment. Never commit the populated .env file.
# Generate each secret independently; use a secret manager in production.
DAEP_ADMIN_TOKEN=replace-with-a-unique-random-secret-at-least-32-characters
DAEP_WORKER_TOKEN=replace-with-a-different-random-secret-at-least-32-characters

# PostgreSQL bootstrap, runtime and privileged credentials must be independent.
DAEP_POSTGRES_PASSWORD=replace-with-a-bootstrap-database-password
DAEP_RUNTIME_DB_PASSWORD=replace-with-a-runtime-database-password
DAEP_PRIVILEGED_DB_PASSWORD=replace-with-a-privileged-database-password

# Bind API to loopback when TLS is terminated by a host reverse proxy.
DAEP_BIND_ADDRESS=127.0.0.1
DAEP_PORT=8000
# Replace with the exact browser origin(s); do not use * with credentials.
CORS_ORIGINS=https://daep.example.com

# OIDC authorization-code flow. Keep auto-provision disabled unless explicitly approved.
DAEP_OIDC_ISSUER=https://idp.example.com/realms/daep
DAEP_OIDC_CLIENT_ID=daep-web
DAEP_OIDC_CLIENT_SECRET=replace-with-idp-client-secret
DAEP_OIDC_REDIRECT_URI=https://daep.example.com/api/v1/auth/oidc/callback
DAEP_OIDC_AUTO_PROVISION=false
DAEP_OIDC_DEFAULT_TENANT=tenant-default
DAEP_OIDC_DEFAULT_ROLE=developer
DAEP_OIDC_SCOPES=openid profile email
# Optional provider-specific audience; omit if the provider does not require one.
# DAEP_OIDC_AUDIENCE=daep-api

# Worker is required for Outbox delivery and periodic collaboration-grant reminders/expiry.
# Start it with: docker compose -f compose.production.yaml --profile broker up -d daep-worker
DAEP_BROKER_WEBHOOK_URL=https://broker.example.com/daep/events
DAEP_BROKER_WEBHOOK_TOKEN=replace-with-a-broker-specific-secret-at-least-32-characters
DAEP_WORKER_ID=daep-worker-1

# Optional Git webhook secrets. Prefer provider-specific secrets where applicable.
# DAEP_GIT_WEBHOOK_SECRET=
# DAEP_GITHUB_WEBHOOK_SECRET=
# DAEP_GITLAB_WEBHOOK_SECRET=
